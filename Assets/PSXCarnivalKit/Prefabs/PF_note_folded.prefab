  m_Name: 
  m_EditorClassIdentifier: HeyHeyThere.PSXCarnivalKit::HeyHeyThere.PSXCarnivalKit.Pickup
  kind: 0
  item: note
  amount: 1
  title: Folded Note
  text: Dale - I'm not doing another night out here. Something's living in the ghost
    train, I hear it laughing in there after the power's off. Generator key's in
    Giggles' trailer, the booth key's on the strongman's stand, the ride key's in
    the ticket booth. You want the rides checked, check them yourself. - Hal
  reveal: unfold
  clip: 
  takes: 
