  m_Script: {fileID: 11500000, guid: a97a2e2cfcb01ac48be2af880b38b3fc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Jamlloween.Roteiro.IntroScreen
  director: {fileID: 81572220}
  walker: {fileID: 127641598}
  interactor: {fileID: 2018857432}
  blocks:
  - "Voc\xEA \xE9 o t\xE9cnico de manuten\xE7\xE3o do parque O Incr\xEDvel Mundo de Zatan.\nO turno da noite \xE9 seu.\nLuzes, fus\xEDveis, brinquedos que ningu\xE9m mais quer consertar."
  - "Dizem que o parque fecha \xE0s dez.\nDizem tamb\xE9m que nem tudo l\xE1 dentro sabe disso.\nFa\xE7a o seu trabalho. N\xE3o demore.\nE se a cabine do adivinho estiver acesa, n\xE3o pare para ouvir sua sorte."
  prompt: Pressione qualquer tecla para continuar
  startDelay: 1.2
  lineFadeIn: 1.4
  lineInterval: 2.2
  blockHold: 2.5
  blockFadeOut: 1.2
  promptDelay: 0.8
  outroSeconds: 2.5
  audioFadeSeconds: 3
